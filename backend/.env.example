# Copia este archivo a ".env" y pon tus claves reales ahí.
# ".env" nunca se sube a git (ver .gitignore).

# https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# https://developer.cityofnewyork.us/  (producto "Geoclient")
# Si los dejas vacíos, el backend usa Nominatim (gratis, sin clave) como respaldo automático.
GEOCLIENT_ID=
GEOCLIENT_KEY=

PORT=3001
